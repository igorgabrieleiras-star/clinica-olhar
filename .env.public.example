# =====================================================================
#  SERVIÇO 1 — SITE PÚBLICO DE AGENDAMENTO (único endereço divulgado)
# =====================================================================
APP_ROLE=public
NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# Domínio público usado nos anúncios. Ex.: https://exame.clinicaolhar.com.br
APP_URL=

# Conexão com o usuário RESTRITO do banco (gerada por: npm run db:public-user).
# Nunca use aqui o usuário dono do banco: o site recusa iniciar em produção se tiver permissões administrativas.
DATABASE_URL=
DATABASE_SSL=

# Segredo próprio deste serviço (openssl rand -hex 32). Usado para hash de IP nos consentimentos.
SESSION_SECRET=

# API de Conversões da Meta (o envio do Lead acontece no momento do agendamento, neste serviço)
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v21.0

# Reservas por IP por hora (padrão 8)
BOOKING_RATE_LIMIT=8
