# =====================================================================
#  SERVIÇO 2 — PAINEL ADMINISTRATIVO (privado, não divulgado, não indexado)
# =====================================================================
APP_ROLE=admin
NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# Endereço interno do painel. Ex.: https://gestao.clinicaolhar.com.br
APP_URL=
# Endereço do site público (links "Ver site" e "Ver política" no painel)
PUBLIC_SITE_URL=

# Conexão com o usuário DONO do banco (aplica migrações e permissões do site)
DATABASE_URL=
DATABASE_SSL=
# Usuário restrito do site público: com PUBLIC_DB_PASSWORD definido (20+ caracteres), o painel cria/atualiza
# o usuário automaticamente a cada início. O site usa: postgres://olhar_site:<PUBLIC_DB_PASSWORD>@<mesmo host>/<mesmo banco>
PUBLIC_DB_ROLE=olhar_site
PUBLIC_DB_PASSWORD=

# Segredo próprio deste serviço, diferente do site (openssl rand -hex 32)
SESSION_SECRET=

# Primeiro administrador (criado só se não existir nenhum; troca de senha obrigatória no 1º login)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ---- Camada extra de acesso (OPCIONAL; o painel já exige login individual por e-mail e senha) ----
# A) Cloudflare Access — login por e-mail/Google da equipe antes de chegar ao painel (recomendado)
ADMIN_CF_ACCESS_TEAM_DOMAIN=
ADMIN_CF_ACCESS_AUD=
# B) IPs permitidos (IP fixo da clínica, VPN). Aceita CIDR. Ex.: 200.150.10.20,10.8.0.0/24
ADMIN_ALLOWED_IPS=
# C) Senha compartilhada extra (não recomendada; prefira A ou B). Mínimo 16 caracteres.
ADMIN_GATE_USER=
ADMIN_GATE_PASSWORD=

# Usado pelo painel para exibir se o token da API de Conversões está configurado no site
META_CAPI_ACCESS_TOKEN=